# ---------------------------------------------------------------------------
# Sabino Academia - variaveis de ambiente
# Copie para .env.local e preencha. Nunca versione .env.local.
# ---------------------------------------------------------------------------

# URL publica do site (usada em metadata, Open Graph e JSON-LD)
NEXT_PUBLIC_SITE_URL="https://sabinoacademia.com.br"

# --- Upstash Redis (banco principal) ---------------------------------------
# Se voce ligou a integracao Upstash pela Vercel (Storage), ela ja cria
# KV_REST_API_URL e KV_REST_API_TOKEN e o app usa essas automaticamente -
# nao precisa preencher as duas abaixo.
# (KV_URL e REDIS_URL sao do protocolo TCP e nao servem aqui.)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Primeiro administrador -------------------------------------------------
# E-mails que entram como ADMIN mesmo sem publicMetadata.role definido.
# Resolve o bootstrap: sem isso, ninguem conseguiria aprovar o proprio cadastro.
# Separe varios por virgula. A SENHA nunca fica aqui - ela vive no Clerk.
ADMIN_EMAILS="seu-email@exemplo.com"

# --- Clerk (autenticacao) ---------------------------------------------------
# O papel do usuario fica em publicMetadata.role = "ADMIN" | "ALUNO"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/entrar"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/cadastro"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/painel"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/onboarding"

# --- Vercel Blob (documentos privados dos alunos) ---------------------------
BLOB_READ_WRITE_TOKEN=""

# --- Check-in por QR Code ---------------------------------------------------
# Quantos segundos o QR da recepcao vale antes de girar (30 a 900).
QR_TOKEN_TTL_SECONDS="120"

# --- Contato ----------------------------------------------------------------
# Numero no formato internacional, somente digitos (ex.: 5551981691373)
NEXT_PUBLIC_WHATSAPP_NUMBER="5551981691373"
