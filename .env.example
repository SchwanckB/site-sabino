# ---------------------------------------------------------------------------
# Sabino Academia - variaveis de ambiente
# Copie para .env.local e preencha. Nunca versione .env.local.
# ---------------------------------------------------------------------------

# URL publica do site (usada em metadata, Open Graph e JSON-LD)
NEXT_PUBLIC_SITE_URL="https://sabinoacademia.com.br"

# --- Upstash Redis (banco principal) ---------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Clerk (autenticacao) ---------------------------------------------------
# O papel do usuario fica em publicMetadata.role = "ADMIN" | "ALUNO"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/entrar"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/cadastro"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/painel"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/onboarding"

# --- Vercel Blob (documentos privados dos alunos) ---------------------------
BLOB_READ_WRITE_TOKEN=""

# --- Check-in por QR Code ---------------------------------------------------
# Segredo usado para assinar o token rotativo exibido na recepcao
QR_TOKEN_SECRET=""
QR_TOKEN_TTL_SECONDS="120"

# --- Contato ----------------------------------------------------------------
# Numero no formato internacional, somente digitos (ex.: 5551981691373)
NEXT_PUBLIC_WHATSAPP_NUMBER="5551981691373"
